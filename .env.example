# Copy to .env and adjust. .env is gitignored; never commit real keys.
# All settings live in src/switchboard/config.py.

# Local model served by vLLM (changing either invalidates data/labels/)
SWITCHBOARD_LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
SWITCHBOARD_LOCAL_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
SWITCHBOARD_LOCAL_BASE_URL=http://localhost:8001/v1

# Frontier model (Phase 2): Claude Opus 5.5 through OpenRouter.
# Put your real key only in .env (gitignored). Never commit it or paste it into chat.
# Set a credit limit on the key in OpenRouter's dashboard as a hard spend ceiling.
SWITCHBOARD_FRONTIER_MODEL_ID=anthropic/claude-opus-5.5
OPENROUTER_API_KEY=

# Label generation
SWITCHBOARD_LABEL_CONCURRENCY=32

# Code sandbox
SWITCHBOARD_SANDBOX_WORKERS=4
SWITCHBOARD_SANDBOX_TIMEOUT_S=10
